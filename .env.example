# ridger.ch — required environment (see .github/workflows/build-and-deploy.yml)
NEXT_PUBLIC_SITE_URL=https://ridger.ch
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
FORMSPARK_ACTION_URL=
INDEXNOW_SECRET=
RESTART_SECRET_TOKEN=
# Locales built but noindexed until content is reviewed
PLACEHOLDER_LOCALES=de,es,pt
# Server port on the shared VPS (houle.ai holds 5000)
PORT=5001
# Article pipeline (scripts/ai-ressources-update.js — CI secrets; see docs/article-pipeline.md)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_API_VERSION=2025-01-01-preview
AZURE_OPENAI_DRAFT_DEPLOYMENT=gpt-5.2
# optional: research deployment / Foundry web-search agent
AZURE_OPENAI_RESEARCH_ENDPOINT=
AZURE_OPENAI_RESEARCH_API_KEY=
AZURE_OPENAI_RESEARCH_DEPLOYMENT=
AZURE_AGENT_ENDPOINT=
AZURE_AGENT_API_KEY=
AZURE_AGENT_NAME=web-deep-search:6
